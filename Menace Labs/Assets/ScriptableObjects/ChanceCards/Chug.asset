%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3ae2742537362a4d936cd96da1eb7e8, type: 3}
  m_Name: Chug
  m_EditorClassIdentifier: 
  image: {fileID: 21300000, guid: fc1ec0103a9051d4d8f305dbfe985b44, type: 3}
  title: Chug Chug Chug!!
  description: "The clone is sat down at a table. The left side is indicated as option
    1 and holds 50 burgers. The right is indicated as option 2 and holds 50 beers.
    The clone is informed that it can take as much time as needed but should try
    to be quick about consuming as much of either side as possible. Which should
    it go for?\r"
  A_ButtonText: Burgers
  A_Chance: 10
  A_SuccessModifier:
    skillType: 8
    needType: 8
    checkValue: 0
    checkIfLower: 0
    modifyValue: 0
  A_SuccessDescription: "At burger 49 only 6 minutes in a massive group of scientists
    and guards has gathered around your clone in anticipation. On the final swallow
    there is a racuous cheer everyone is amazed! The clone is escorted back to his
    facilities. [Full hunger and end test]\r"
  A_SuccessEffects:
  - {fileID: 11400000, guid: 2ccea11feb5210c498ec672a4f103ead, type: 2}
  - {fileID: 11400000, guid: 79d6b02b1cd555f4584ed731bb10f47d, type: 2}
  A_FailureDescription: "Your clone can only get through the burgers by taking its
    time. The board scientists monitoring it breathe sighs of relief when the final
    bite is taken. [+4h test time]\r"
  A_FailureEffects:
  - {fileID: 11400000, guid: 2aded1f1d1d149147b803dcd94f2d62a, type: 2}
  B_ButtonText: Beer
  B_Chance: 10
  B_SuccessModifier:
    skillType: 8
    needType: 8
    checkValue: 0
    checkIfLower: 0
    modifyValue: 0
  B_SuccessDescription: "When the final beer slams down on the table the clone is
    barely coherent but the scientists are beyond impressed at its constitution.
    It is given the time to nap and recover along with a billion different hangover
    cures. [Max sleep]\r"
  B_SuccessEffects:
  - {fileID: 11400000, guid: 5630cc649102a924583c9bb55efe3e6e, type: 2}
  B_FailureDescription: "The clone has passed out 3 beers in. The scientists groan
    realising that this will be a very long test. [+4h test time]\r"
  B_FailureEffects:
  - {fileID: 11400000, guid: 2aded1f1d1d149147b803dcd94f2d62a, type: 2}
