  m_Script: {fileID: 11500000, guid: f3ae2742537362a4d936cd96da1eb7e8, type: 3}
  m_Name: Stare
  m_EditorClassIdentifier: 
  image: {fileID: 21300000, guid: 41427cfda4a524249b2b78c58019cc43, type: 3}
  title: Staring Competition
  description: "Your clone is escorted to test chamber #12. There it is given a heavy
    bowl of fruit and placed opposite a particularly aggressive looking lab guard.
    The clone is told to maintain eye contact with the guard but the pressure is
    insurmountable and eventually it panics and drops the fruit bowl. The clone looks
    around for guidance but receives none.Should the clone...\r"
  A_ButtonText: Escape!
  A_Chance: 40
  A_SuccessModifier:
    skillType: 8
    needType: 8
    checkValue: 0
    checkIfLower: 0
    modifyValue: 0
  A_SuccessDescription: "Your clone runs at lightning speed from the chamber to their
    quarters. God knows what that test was about but at least it's over now. [Test
    ends]\r"
  A_SuccessEffects:
  - {fileID: 11400000, guid: 79d6b02b1cd555f4584ed731bb10f47d, type: 2}
  A_FailureDescription: "Your clone stupidly runs headfirst into the door in its
    panic. [Random loss of 1 skill point]\r"
  A_FailureEffects:
  - {fileID: 11400000, guid: c766e5fb614b20a43ba701bddd9ee9a0, type: 2}
  B_ButtonText: Tidy Up
  B_Chance: 60
  B_SuccessModifier:
    skillType: 0
    needType: 8
    checkValue: 3
    checkIfLower: 0
    modifyValue: 20
  B_SuccessDescription: "As the clone picks up the fruit the scary guard comes over
    to help them. This slight bit of human interaction exhilerates the clone and
    they enjoy the remaining time spent on the staring competition with their new
    friend. [Social maxed out]\r"
  B_SuccessEffects:
  - {fileID: 11400000, guid: 7712e7205a2d0f74380f90e465520254, type: 2}
  B_FailureDescription: "The fruit is rotten and more of it ends up on the clone
    than on the floor but the scientists look pleased at this. [Reduced hygiene]\r"
  B_FailureEffects:
  - {fileID: 11400000, guid: c612849ed2c305b4b8ef30d3d790212a, type: 2}
